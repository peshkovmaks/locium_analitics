# === Core app settings ===
DATABASE_URL=postgresql+asyncpg://mp_user:mp_password@localhost:5432/marketplace_analytics
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-in-production-super-secret-key-2026
ENCRYPTION_KEY=change-me-in-production-super-secret-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === Telegram notifications (optional) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Ozon API credentials ===
# Get from: https://seller.ozon.ru/  -> Settings -> API
OZON_CLIENT_ID=
OZON_API_KEY=
# Ozon Performance API (advertising stats; optional, required for Ozon adverts sync).
# Get from: https://performance.ozon.ru/  -> OAuth authorization; use the
# Performance Client-Id and the OAuth access token issued for your account.
# The Performance Client-Id may differ from the seller Client-Id above.
# In the app these are stored per shop as `performance_client_id` and
# `performance_access_token` credentials; without them Ozon adverts are skipped.
# OZON_PERFORMANCE_CLIENT_ID=
# OZON_PERFORMANCE_ACCESS_TOKEN=

# === Wildberries API credentials ===
# Get from: https://seller.wildberries.ru/  -> Profile -> API access
WB_API_KEY=

# === Yandex Market API credentials ===
# Get from: https://partner.market.yandex.ru/  -> Settings -> Authorization
YM_API_KEY=
# YM_OAUTH_TOKEN=           # legacy OAuth alternative; fill if using OAuth
# YM_BUSINESS_ID=           # optional, auto-detected for OAuth
# YM_CAMPAIGN_ID=            # campaign identifier
